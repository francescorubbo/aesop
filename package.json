{
  "name": "aesop",
  "version": "0.2.0",
  "description": "Distributed ML experiment orchestration CLI powered by the Pi coding agent SDK",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "aesop": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "commander": "^12.0.0",
    "simple-git": "^3.22.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ml",
    "machine-learning",
    "experiment-tracking",
    "cli",
    "pi",
    "coding-agent"
  ],
  "license": "MIT"
}
